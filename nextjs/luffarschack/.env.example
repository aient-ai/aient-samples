# Server telemetry
AIENT_PUBLISHABLE_KEY=
OTEL_SERVICE_NAME=luffarschack
OTEL_EXPORTER_OTLP_ENDPOINT=https://ingest.aient.ai
# Optional on Vercel, which supplies VERCEL_GIT_COMMIT_SHA/VERCEL_GIT_COMMIT_REF.
COMMIT_SHA=
COMMIT_REF=
AIENT_ENV=prod

# Browser telemetry (the build copies COMMIT_SHA/COMMIT_REF/AIENT_ENV by default)
NEXT_PUBLIC_AIENT_PUBLISHABLE_KEY=
NEXT_PUBLIC_OTEL_SERVICE_NAME=luffarschack
NEXT_PUBLIC_OTEL_EXPORTER_OTLP_ENDPOINT=https://ingest.aient.ai
NEXT_PUBLIC_COMMIT_SHA=
NEXT_PUBLIC_COMMIT_REF=
NEXT_PUBLIC_AIENT_ENV=prod

# Build-only upload credential; never expose this as NEXT_PUBLIC_*
AIENT_API_KEY=

# Override when deployed server stack paths use an absolute application root.
AIENT_SERVER_BUNDLE_PREFIX=/.next/server