# Runtime telemetry. Publishable ingest keys are safe to provide to their
# respective runtimes, but should still be configured through deployment env.
AIENT_PUBLISHABLE_KEY=pk_replace_me
OTEL_SERVICE_NAME=luffarschack
OTEL_EXPORTER_OTLP_ENDPOINT=https://ingest.aient.ai

NEXT_PUBLIC_AIENT_PUBLISHABLE_KEY=pk_replace_me
NEXT_PUBLIC_OTEL_SERVICE_NAME=luffarschack
NEXT_PUBLIC_OTEL_EXPORTER_OTLP_ENDPOINT=https://ingest.aient.ai

# Use the exact same release identity for runtime telemetry and source maps.
COMMIT_SHA=
COMMIT_REF=
BUILD_DATE=
AIENT_ENV=prod
NEXT_PUBLIC_COMMIT_SHA=
NEXT_PUBLIC_COMMIT_REF=
NEXT_PUBLIC_AIENT_ENV=prod

# Build-only secret. Never expose this as a NEXT_PUBLIC_ variable.
AIENT_API_KEY=

# Override when server stack frames use a different deployed bundle root.
AIENT_SERVER_BUNDLE_PREFIX=.next/server