# Runtime telemetry (publishable ingest credentials are safe to expose only via these intended variables)
AIENT_PUBLISHABLE_KEY=
OTEL_SERVICE_NAME=luffarschack
OTEL_EXPORTER_OTLP_ENDPOINT=https://ingest.aient.ai
COMMIT_SHA=
COMMIT_REF=
AIENT_ENV=prod

# Browser telemetry
NEXT_PUBLIC_AIENT_PUBLISHABLE_KEY=
NEXT_PUBLIC_OTEL_SERVICE_NAME=luffarschack
NEXT_PUBLIC_OTEL_EXPORTER_OTLP_ENDPOINT=https://ingest.aient.ai
# The build falls back to COMMIT_SHA, COMMIT_REF, and AIENT_ENV when these are unset.
NEXT_PUBLIC_COMMIT_SHA=
NEXT_PUBLIC_COMMIT_REF=
NEXT_PUBLIC_AIENT_ENV=prod

# Build-only upload credential. Never expose this as a NEXT_PUBLIC_* variable.
AIENT_API_KEY=