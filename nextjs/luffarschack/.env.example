# Browser telemetry (publishable credential; safe to expose to this app's users)
NEXT_PUBLIC_AIENT_PUBLISHABLE_KEY=
NEXT_PUBLIC_OTEL_SERVICE_NAME=luffarschack
NEXT_PUBLIC_OTEL_EXPORTER_OTLP_ENDPOINT=https://ingest.aient.ai

# Server telemetry (publishable credential)
AIENT_PUBLISHABLE_KEY=
OTEL_SERVICE_NAME=luffarschack
OTEL_EXPORTER_OTLP_ENDPOINT=https://ingest.aient.ai

# Release metadata. The production build copies the server values to the browser
# bundle when the corresponding NEXT_PUBLIC_* value is omitted.
COMMIT_SHA=
COMMIT_REF=
BUILD_DATE=
AIENT_ENV=prod