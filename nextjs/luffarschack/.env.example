# Browser telemetry (embedded into the client bundle at build time)
NEXT_PUBLIC_AIENT_PUBLISHABLE_KEY=
NEXT_PUBLIC_OTEL_SERVICE_NAME=luffarschack-web
NEXT_PUBLIC_OTEL_EXPORTER_OTLP_ENDPOINT=https://ingest.aient.ai
NEXT_PUBLIC_COMMIT_SHA=
NEXT_PUBLIC_COMMIT_REF=
NEXT_PUBLIC_AIENT_ENV=prod

# Server telemetry
AIENT_PUBLISHABLE_KEY=
OTEL_SERVICE_NAME=luffarschack
OTEL_EXPORTER_OTLP_ENDPOINT=https://ingest.aient.ai
COMMIT_SHA=
COMMIT_REF=
AIENT_ENV=prod

# Build metadata (optional, retained for deployment tooling)
BUILD_DATE=

# Secret upload-scoped key. Configure this only in CI/hosting secrets.
AIENT_API_KEY=